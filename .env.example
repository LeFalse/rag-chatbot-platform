# PostgreSQL
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb

# OpenAI (optional - use Ollama for local development)
OPENAI_API_KEY=

# Redis (default: redis://redis:6379/0)
# REDIS_URL=redis://redis:6379/0

# Ollama (default: http://ollama:11434)
# OLLAMA_BASE_URL=http://ollama:11434

# LLM Model - which model Ollama will pull and use
# Options: qwen3:8b (best for tool calling), llama3.2 (lighter)
LLM_MODEL=qwen3:8b

# GitLab MCP Integration (optional)
# Personal Access Token with read_api scope for repository access
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
